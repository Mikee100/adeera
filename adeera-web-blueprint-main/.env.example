# App name (optional)
APP_NAME=ADEERA COMPANY

# SaaS app URL — used for the "Log in" link in the header. No trailing slash.
# Example: https://app.adeeraunitech.com
VITE_APP_URL=

# --- backend/server.js contact form ---
# Gmail account used to send contact-form notifications.
# Generate an app password at https://myaccount.google.com/apppasswords
# (regular account passwords will not work with nodemailer's Gmail transport).
# NEVER commit real values here — this file is the template, not the secret.
CONTACT_EMAIL_USER=
CONTACT_EMAIL_PASS=
# Inbox that receives contact-form submissions. Defaults to contact@adeeraunitech.com.
CONTACT_EMAIL_TO=
